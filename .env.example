# Copy to .env.local for local development. Never commit the real file.
# In production these are set in Vercel: Project → Settings → Environment Variables.

# Required to enable assisted extraction. Without it the endpoint reports
# itself unavailable and the application behaves exactly as it does offline.
OPENAI_API_KEY=

# Optional. Overrides the model preference order, otherwise gpt-5 then gpt-4o.
OPENAI_MODEL=

# Optional. A token the client must present. Raises the effort needed to abuse
# a public endpoint; a value shipped in a browser bundle is not a secret.
AI_APP_TOKEN=
